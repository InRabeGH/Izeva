{
    "name": "izeva",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev --turbo",
        "build": "next build",
        "start": "next start",
        "analyze": "ANALYZE=true next build",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "typecheck": "tsc --noEmit",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "test:db": "bun test tests/db",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "drizzle-kit migrate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "auth:generate": "bunx @better-auth/cli generate",
        "commitlint": "commitlint --edit",
        "knip": "DATABASE_URL='postgresql://noop' knip",
        "knip:fix": "DATABASE_URL='postgresql://noop' knip --fix --allow-remove-files",
        "prepare": "lefthook install"
    },
    "dependencies": {
        "@neondatabase/serverless": "^0.10.4",
        "@uploadthing/react": "^7.3.0",
        "better-auth": "^1.3.10",
        "class-variance-authority": "^0.7.1",
        "client-only": "^0.0.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.36.4",
        "lucide-react": "^0.469.0",
        "next": "^16.0.0",
        "next-safe-action": "^8.5.2",
        "radix-ui": "^1.4.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "server-only": "^0.0.1",
        "tailwind-merge": "^2.6.0",
        "uploadthing": "^7.5.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.0.0",
        "@commitlint/cli": "^20.5.3",
        "@commitlint/config-conventional": "^20.5.3",
        "@next/bundle-analyzer": "^16.2.5",
        "@tailwindcss/postcss": "^4.0.0",
        "@types/bun": "^1.3.13",
        "@types/node": "^22.10.5",
        "@types/react": "^19.0.7",
        "@types/react-dom": "^19.0.3",
        "babel-plugin-react-compiler": "^1.0.0",
        "drizzle-kit": "^0.30.1",
        "knip": "^6.12.0",
        "lefthook": "^2.1.6",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.2.0",
        "typescript": "^5.7.3"
    },
    "engines": {
        "bun": ">=1.1.0"
    }
}
