{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "release-type": "node",
    "bootstrap-sha": "HEAD",
    "include-v-in-tag": true,
    "include-component-in-tag": false,
    "packages": {
        ".": {
            "package-name": "izeva",
            "release-type": "node",
            "changelog-path": "CHANGELOG.md",
            "changelog-sections": [
                { "type": "feat", "section": "Funcionalidades" },
                { "type": "fix", "section": "Correcciones" },
                { "type": "perf", "section": "Mejoras de rendimiento" },
                { "type": "revert", "section": "Reverts" },
                { "type": "docs", "section": "Documentación" },
                { "type": "refactor", "section": "Refactor" },
                { "type": "style", "section": "Estilo", "hidden": true },
                { "type": "test", "section": "Tests", "hidden": true },
                { "type": "chore", "section": "Tareas internas", "hidden": true },
                { "type": "ci", "section": "CI", "hidden": true },
                { "type": "build", "section": "Build", "hidden": true }
            ],
            "draft": false,
            "prerelease": false
        }
    }
}
